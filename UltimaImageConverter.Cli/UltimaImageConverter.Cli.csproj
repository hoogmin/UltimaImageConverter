<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<ApplicationIcon>..\uic_icon.ico</ApplicationIcon>
	<Authors>Javier Martinez</Authors>
	<Product>Ultima Image Converter</Product>
	<Description>Free, Open-Source, and Private Image Conversion Tool</Description>
	<Title>Ultima Image Converter CLI</Title>
	<PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
	<PackageId>UltimaImageConverter CLI</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UltimaImageConverter.Core\UltimaImageConverter.Core.csproj" />
  </ItemGroup>

</Project>
