<Window x:Class="UltimaImageConverter.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ultima Image Converter" Height="480" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        AllowDrop="True" Drop="Window_Drop">

    <Window.Resources>
        <!-- Dark Theme Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E1E1E1"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#E1E1E1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E1E1E1"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E1E1E1"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Padding="5,2">
            <MenuItem Header="_File">
                <MenuItem Header="_Open images..." Click="MenuOpen_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About uic..." Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- Top Controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="15,10,15,10">
            <Button x:Name="BtnBrowse" Content="Add Images" Width="100" Height="30" Click="BtnBrowse_Click"/>
            <Button x:Name="BtnClear" Content="Clear All" Width="80" Height="30" Margin="10,0,0,0" Click="BtnClear_Click"/>
        </StackPanel>

        <!-- Drop Zone & File List -->
        <Grid Grid.Row="2" Margin="15,0,15,15" Background="Transparent">
            <Rectangle Stroke="#555555" StrokeThickness="2" StrokeDashArray="4 4" RadiusX="5" RadiusY="5" />

            <ListBox x:Name="LstFiles" Margin="2" SelectionMode="Extended" 
                     DisplayMemberPath="FileName" KeyDown="LstFiles_KeyDown">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Remove Selected" Click="MenuRemoveSelected_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <TextBlock x:Name="FileCountText" Text="Drag &amp; drop image files here" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                       Foreground="#888888" FontSize="16" IsHitTestVisible="False"/>
        </Grid>

        <!-- Output Directory (Insert at Grid.Row="3") -->
        <Grid Grid.Row="3" Margin="15,0,15,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Output:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Border Grid.Column="1" BorderBrush="#3F3F46" BorderThickness="1" Background="#252526" Padding="5,0" Margin="0,0,10,0">
                <TextBlock x:Name="TxtOutputDir" Text="Same as input directory" VerticalAlignment="Center" Foreground="#888888" TextTrimming="CharacterEllipsis"/>
            </Border>
            <Button x:Name="BtnBrowseOutput" Grid.Column="2" Content="Browse..." Width="70" Height="25" Click="BtnBrowseOutput_Click"/>
            <Button x:Name="BtnResetOutput" Grid.Column="3" Content="Reset" Width="50" Height="25" Margin="5,0,0,0" Click="BtnResetOutput_Click" IsEnabled="False"/>
        </Grid>
        
        <!-- Conversion Settings -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="15,0,15,15">
            <TextBlock Text="Target Format:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="CmbFormat" Width="100" SelectedIndex="0">
                <ComboBoxItem Content="Png"/>
                <ComboBoxItem Content="Jpeg"/>
                <ComboBoxItem Content="Webp"/>
                <ComboBoxItem Content="Avif"/>
                <ComboBoxItem Content="Tiff"/>
                <ComboBoxItem Content="Bmp"/>
            </ComboBox>

            <TextBlock Text="Quality:" VerticalAlignment="Center" Margin="20,0,10,0"/>
            <Slider x:Name="SldQuality" Minimum="1" Maximum="100" Value="90" Width="120" VerticalAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True"/>
            <TextBlock Text="{Binding ElementName=SldQuality, Path=Value}" VerticalAlignment="Center" Margin="10,0,0,0" Width="30"/>
        </StackPanel>

        <!-- Action Bar -->
        <Grid Grid.Row="5" Margin="15,0,15,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar x:Name="ProgressBar" Grid.Column="0" Margin="0,0,15,0" Minimum="0" Maximum="100" Height="35" Background="#333337" Foreground="#007ACC" BorderBrush="#3F3F46"/>
            <TextBlock x:Name="StatusText" Grid.Column="0" Text="Ready" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" IsHitTestVisible="False"/>

            <Button x:Name="BtnConvert" Grid.Column="1" Content="Convert" Width="100" Height="35" Click="BtnConvert_Click" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>