<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<!-- Sets the icon for the .exe file in Windows File Explorer -->
		<ApplicationIcon>uic_icon.ico</ApplicationIcon>
		<Authors>Javier Martinez</Authors>
		<Product>UltimaImageConverter GUI</Product>
	</PropertyGroup>

	<ItemGroup>
		<!-- Embeds the icon so the WPF Window can use it in the top corner -->
		<Resource Include="uic_icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\UltimaImageConverter.Core\UltimaImageConverter.Core.csproj" />
	</ItemGroup>

</Project>